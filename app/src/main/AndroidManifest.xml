        <activity android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:name=".SharedLocationActivity"
            android:exported="true"
           
            android:theme="@style/AppTheme">

            <!-- Tautan lokasi yang diketuk dari WhatsApp/Google Maps -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>

            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="maps.google.com" />
                <data android:scheme="https" android:host="www.google.com" android:pathPrefix="/maps" />
                <data android:scheme="https" android:host="google.com" android:pathPrefix="/maps" />
                <data android:scheme="https" android:host="maps.app.goo.gl" />
                <data android:scheme="https" android:host="goo.gl" android:pathPrefix="/maps" />
            </intent-filter>

            <!-- Saat lokasi/link dibagikan melalui menu Share -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

