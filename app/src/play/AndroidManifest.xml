<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Google Play distribution hardening. Keep direct APK behavior unchanged. -->

    <!-- Transiva Customer does not use advertising identifiers. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <!-- Direct-channel APK self updater must never be present in Play AAB. -->
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <!--
      Play policy: broad photo/video library access is not required.
      Customer image/file flows already use Android's document picker
      (ACTION_OPEN_DOCUMENT / ACTION_GET_CONTENT) and camera-owned URIs.
      Removing these permissions does NOT remove the picker/camera features.
    -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />

    <!--
      Intentionally inherited from main:
      - USE_FULL_SCREEN_INTENT: incoming customer WebRTC call only.
      - SYSTEM_ALERT_WINDOW: optional Trans Asisten/call overlay flow.
      - FOREGROUND_SERVICE_DATA_SYNC: active trip/redispatch protection.
      - FOREGROUND_SERVICE_MICROPHONE: user-initiated Audio Protect.
      These must match the corresponding Play Console declarations/use cases.
    -->

</manifest>
